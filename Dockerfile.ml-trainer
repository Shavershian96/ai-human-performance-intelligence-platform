# ML Trainer microservice - Multi-stage production build
FROM python:3.11-slim AS builder

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

FROM python:3.11-slim AS runtime
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 && rm -rf /var/lib/apt/lists/*

# Unprivileged runtime user. /app/models is the mount point for the shared
# model volume and this service writes the trained artifacts there, so it has
# to be owned by that user in the image.
RUN useradd --create-home --uid 10001 appuser

COPY --from=builder --chown=appuser:appuser /root/.local /home/appuser/.local
ENV PATH=/home/appuser/.local/bin:$PATH
COPY --chown=appuser:appuser . .
RUN mkdir -p /app/models && chown -R appuser:appuser /app/models
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1

USER appuser

EXPOSE 8080
CMD ["uvicorn", "src.ml_trainer.main:app", "--host", "0.0.0.0", "--port", "8080"]
